# Local-only configuration for `supabase functions serve` (copy to supabase/functions/.env).
# supabase/functions/.env is git-ignored. NEVER commit real values.
#
# In the hosted project, set secrets with `supabase secrets set` (or the dashboard).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the
# platform automatically; do not duplicate them as manual secrets in production.

# Local testing fallbacks (ignored on the hosted platform).
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Comma-separated frontend origins allowed by CORS (exact origins, no paths).
CORS_ALLOWED_ORIGINS="https://dfabulous.co.uk"

# Email (server-side only)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="D'Fabulous Events <onboarding@resend.dev>"
RESEND_NOTIFICATION_EMAIL="notifications@example.com"
RESEND_TESTING_MODE="true"
RESEND_TESTING_EMAIL="your-verified-resend-testing-email@example.com"

# LOCAL DEVELOPMENT ONLY: allows an in-memory rate limiter when the
# public.consume_rate_limit() RPC is not yet migrated. It is hard-disabled whenever
# the function detects a hosted/production runtime. NEVER set this as a production secret.
# RATE_LIMIT_DEV_FALLBACK="true"
