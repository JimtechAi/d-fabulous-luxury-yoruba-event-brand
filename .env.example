# Local development must stay pinned to port 3001.
VITE_APP_URL="http://localhost:3001"
# Use an empty value for same-origin local development. Set this to the deployed
# Node/Express backend URL for the Vercel frontend.
VITE_API_BASE_URL=""

# SUPABASE CONFIGURATION (Client-Safe)
# Use VITE_ prefix for public client-side keys ONLY.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# DO NOT EXPOSE SUPABASE_SERVICE_ROLE_KEY IN CLIENT-SIDE CODE OR VITE_ VARIABLES!
# SUPABASE_SERVICE_ROLE_KEY is a server-side secret only and must NEVER be prefixed with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Comma-separated Vercel frontend origins allowed by the Express backend.
# Keep this server-only; do not use a VITE_ prefix.
CORS_ALLOWED_ORIGINS="https://dfabulous.co.uk"

# RESEND EMAIL NOTIFICATION CONFIGURATION (Server-Side Only)
# Configure these in your host environment / Vercel environment variables.
RESEND_API_KEY=re_your_resend_api_key_here
# Temporary development sender. Change only this value when a verified production domain is available.
RESEND_FROM_EMAIL=D'Fabulous Events <onboarding@resend.dev>
RESEND_NOTIFICATION_EMAIL=fabulousevents@hotmail.com
# Set this to the Resend account email allowed in testing mode.
RESEND_TESTING_MODE=true
RESEND_TESTING_EMAIL=your-verified-resend-testing-email@example.com
