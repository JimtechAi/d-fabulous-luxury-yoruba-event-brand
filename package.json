{
  "name": "dfabulous-luxury-yoruba-event-brand",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender-seo.ts && node scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:edge": "deno check --config supabase/functions/dfabulous-api/deno.json supabase/functions/dfabulous-api/index.ts supabase/functions/dfabulous-api/tests/*.test.ts",
    "test": "npm run test:node && npm run test:edge",
    "test:node": "node --test tests/",
    "test:edge": "deno test --allow-env --no-prompt --config supabase/functions/dfabulous-api/deno.json supabase/functions/dfabulous-api/tests/",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "staging:build": "node scripts/build-staging-install.mjs",
    "staging:check": "node scripts/build-staging-install.mjs --check",
    "stage4:build": "node scripts/build-stage4-baseline.mjs",
    "stage4:check": "node scripts/build-stage4-baseline.mjs --check",
    "schema:validate": "node scripts/schema-export.mjs validate supabase/staging/source/production_public_schema.sql",
    "schema:compare": "node scripts/schema-export.mjs compare supabase/staging/source/production_public_schema.sql supabase/staging/expected/baseline_after_install.pgdump.sql",
    "audit:prod": "npm audit --omit=dev",
    "media:variants": "node scripts/generate-image-variants.mjs",
    "test:parity": "node --test --test-timeout=1500000 scripts/parity/parity.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.19.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
